   "source": [
    "1. Create a NumPy array of shape (5, 5) filled with random integers between 1 and 20. Replace all the elements in the third column with 1."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "42fa46d3",
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "091d0f0f",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "[[11  5  1 16  9]\n",
      " [ 4 19 18 12  2]\n",
      " [ 3 19 20  7  8]\n",
      " [ 8 13  9 10 11]\n",
      " [20 13  5  4 20]]\n"
     ]
    }
   ],
   "source": [
    "arr = np.random.randint(1, 21, size=(5, 5))\n",
    "print(arr)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "1f9e7f44",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "[[11  5  1 16  9]\n",
      " [ 4 19  1 12  2]\n",
      " [ 3 19  1  7  8]\n",
      " [ 8 13  1 10 11]\n",
      " [20 13  1  4 20]]\n"
     ]
    }
   ],
   "source": [
    "arr[:, 2] = 1\n",
    "print(arr)"
   ]
  }
